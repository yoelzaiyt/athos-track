# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: connection string do Postgres do projeto Supabase, via pooler
# em modo transação (pgbouncer). Usada tanto pela API (server/api) quanto
# pelos workers (server/brgps-sync, server/gt06-listener) — role superusuário
# (BYPASSRLS), nunca usada direto pra query de dado de tenant vinda de
# requisição de usuário (ver APP_DATABASE_URL abaixo e server/api/db.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: mesmo Postgres do Supabase, via pooler em modo sessão (sem
# pgbouncer) — usado por server/brgps-sync e server/gt06-listener.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# APP_DATABASE_URL: RLS real como segunda camada de defesa (ver
# SECURITY-GATE-REPORT.md e supabase/migrations/20260828030000_real_rls_defense_in_depth.sql).
# Role athos_app_rw, SEM bypassrls — toda query de dado de tenant feita por
# server/api/rest.ts passa por aqui (server/api/db.ts, withTenantContext).
APP_DATABASE_URL="postgresql://athos_app_rw.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT_SECRET: string aleatória longa usada pela API (server/api) pra assinar
# o token de sessão. Nunca reutilize entre ambientes (dev/prod).
JWT_SECRET="MY_LONG_RANDOM_JWT_SECRET"

# CORS_ORIGIN: domínio do frontend publicado no Vercel (ex: https://athos-track.vercel.app).
# A API só aceita requisições desse origin. Use "*" só em desenvolvimento local.
CORS_ORIGIN="https://<seu-projeto>.vercel.app"

# VITE_API_URL: URL pública da API (server/api), pra onde o frontend (Vercel)
# manda toda chamada de dado/autenticação/realtime. Em dev local, a própria
# API rodando via `npm run api:dev` (http://localhost:4000).
VITE_API_URL="http://localhost:4000"

# Portal de Homologação GT06 (/homologacao). Estes valores são o endereço de
# apontamento que o FORNECEDOR precisa para configurar o dispositivo — não é
# infraestrutura interna, é o dado público do portal. O administrador ATHOS
# define os valores reais por ambiente; nunca hardcode host/porta no código.
VITE_GT06_HOST="MY_GT06_HOMOLOGATION_HOST"
VITE_GT06_TCP_PORT="MY_GT06_HOMOLOGATION_PORT"
VITE_GT06_TRANSPORT="TCP"
VITE_ATHOS_ENV_LABEL="Homologação"
# DEMO_MODE: enquanto não há listener real, o portal simula a conexão/pacotes
# e identifica isso claramente na UI. Trocar para "false" só quando o listener
# TCP real existir e houver um health check de verdade para consultar.
VITE_DEMO_MODE="true"

# MAP V2 POC (MapLibre GL JS) — módulo isolado, ver OPERATIONAL-MAP-ARCHITECTURE.md.
# "false"/ausente = mapa V1 (Leaflet, produção). "true" = MAP V2 (MapLibre, POC).
# Não promover para default sem PASS em MAP-V2-POC-REPORT.md.
VITE_MAP_V2_ENABLED="false"

# Teste de campo com tag física de terceiro, correlacionada por uma etiqueta/
# serial externo (não confundir com o portal de homologação de fornecedor
# acima) — ver server/gt06-listener/homologInstrumentation.ts. Desligado por
# padrão: com GT06_HOMOLOG_MODE != "true" o listener roda exatamente como
# antes, sem nenhuma das rotinas abaixo.
GT06_HOMOLOG_MODE="false"
GT06_HOMOLOG_EXTERNAL_LABEL_ID="MY_TAG_LABEL_ID"
# Porta do servidor HTTP de diagnóstico (GET /diagnostics/gt06 e
# /diagnostics/gt06/<label>) — processo próprio, à parte do server/api.
GT06_HOMOLOG_DIAG_PORT="5080"

# Provider BRGPS (tags de rastreamento reais, fabricante chinês) — código em
# server/integrations/brgps. NUNCA usar prefixo VITE_ nestas: ficam só no
# backend (server/brgps-sync), nunca no bundle do navegador nem em logs.
# BRGPS_ENABLED=false desativa toda chamada ao fornecedor (feature flag).
# Ambientes de teste do fornecedor: internacional http://www.brgps.com/open,
# China http://brseek.39gps.com/open. O endpoint de produção será outro,
# fornecido depois pelo fabricante — nunca hardcode no código, só aqui.
BRGPS_ENABLED="false"
BRGPS_BASE_URL="http://www.brgps.com/open"
BRGPS_API_TOKEN=""
BRGPS_SYNC_INTERVAL_SECONDS="10"

# Segunda conta BRGPS (mesmo fornecedor/protocolo, api_token diferente) —
# ver docs/HARDWARE-CATALOG.md "Hipótese forte (2026-09-06)". Deixado
# preparado (código já aceita, ver server/api/index.ts e
# server/brgps-sync --account=2) mas DESATIVADO até confirmarmos com o
# fornecedor que o token corresponde à tag física real (carrinhos/ativos),
# e não a um tag de demonstração pré-populado por conta trial.
BRGPS2_ENABLED="false"
BRGPS2_BASE_URL="http://www.brgps.com/open"
BRGPS2_API_TOKEN=""
