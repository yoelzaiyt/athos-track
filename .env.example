# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Supabase Postgres via the shared transaction-mode pooler (IPv4-only).
# Used by application code / short-lived queries.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Postgres via the shared session-mode pooler.
# Used for running migrations (supabase/migrations/*.sql).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: safe to expose in the browser bundle
# (VITE_ prefix = inlined into client code by Vite). The anon key is protected by
# each table's Row Level Security policy, not a secret on its own.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Portal de Homologação GT06 (/homologacao). Estes valores são o endereço de
# apontamento que o FORNECEDOR precisa para configurar o dispositivo — não é
# infraestrutura interna, é o dado público do portal. O administrador ATHOS
# define os valores reais por ambiente; nunca hardcode host/porta no código.
VITE_GT06_HOST="MY_GT06_HOMOLOGATION_HOST"
VITE_GT06_TCP_PORT="MY_GT06_HOMOLOGATION_PORT"
VITE_GT06_TRANSPORT="TCP"
VITE_ATHOS_ENV_LABEL="Homologação"
# DEMO_MODE: enquanto não há listener real, o portal simula a conexão/pacotes
# e identifica isso claramente na UI. Trocar para "false" só quando o listener
# TCP real existir e houver um health check de verdade para consultar.
VITE_DEMO_MODE="true"

# Provider BRGPS (tags de rastreamento reais, fabricante chinês) — código em
# server/integrations/brgps. NUNCA usar prefixo VITE_ nestas: ficam só no
# backend (server/brgps-sync), nunca no bundle do navegador nem em logs.
# BRGPS_ENABLED=false desativa toda chamada ao fornecedor (feature flag).
# Ambientes de teste do fornecedor: internacional http://www.brgps.com/open,
# China http://brseek.39gps.com/open. O endpoint de produção será outro,
# fornecido depois pelo fabricante — nunca hardcode no código, só aqui.
BRGPS_ENABLED="false"
BRGPS_BASE_URL="http://www.brgps.com/open"
BRGPS_API_TOKEN=""
BRGPS_SYNC_INTERVAL_SECONDS="15"
